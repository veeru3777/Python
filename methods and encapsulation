#staticmethods

class RoboticsMath:

@staticmethod
def calculate_travel_distance(wheel_diameter_mm, encoder_ticks, ticks_per_rev=360):
    #Finds how far a rover traveled based on physical specs passed in
    circumference = wheel_diameter_mm * 3.14159
    revolutions = encoder_ticks/ticks_per_rev
    return circumference * revolutions

distance = RoboticsMath.calculate_travel_distance(wheel_diameter_mm=80, encoder_ticks=720)
print(f"The wheel rolled precisely: {distance:.2f} mm.")


#Encapsulation

class WaterTank:
    def __init__(self):
        # HIDDEN VARIABLE (indicated by the single underscore)
        # This keeps people from changing the water level directly.
        self._water_level = 0.0

    #(Getter & Setter)
    @property
    def water_level(self):
        """Allows people to look at the water level safely."""
        return self._water_level

    @water_level.setter
    def water_level(self, amount):
        """Acts as a safety valve before changing the actual water."""
        if amount > 100.0:
            print("WARNING: Tank cannot hold that much! Capping it at 100 Liters.")
            self._water_level = 100.0
        elif amount < 0.0:
            print("WARNING: Level cannot be negative! Setting to 0 Liters.")
            self._water_level = 0.0
        else:
            self._water_level = amount
            print(f"Water level successfully adjusted to {self._water_level} Liters.")



my_tank = WaterTank()

# 1. Setting a perfectly safe water level
my_tank.water_level = 45.0  # Output: 💧 Water level successfully adjusted to 45.0 Liters.

# 2. A bug in your code accidentally requests an impossible amount of water
my_tank.water_level = 999.0

# 3. Encapsulation intercepted the bad data and saved the hardware!
print(f"Actual tank water level is safely at: {my_tank.water_level} Liters") # Output: 100.0 Liters
