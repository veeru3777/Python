class GameCharacter:
    # Class variable to track overall game state
    total_characters = 0

    def __init__(self, name):
        self.name = name

        GameCharacter.total_characters += 1


class Warrior(GameCharacter):
    base_health = 150
    mana = 20


class Mage(GameCharacter):
    base_health = 80
    mana = 150


# Multiple Inheritance
class BattleMage(Mage, Warrior):
    base_health = 120
